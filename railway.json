{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "**/*.py",
      "assets.json",
      "requirements.txt",
      "railway.json",
      ".python-version"
    ]
  },
  "deploy": {
    "startCommand": "python main.py",
    "restartPolicyType": "ALWAYS"
  }
}
